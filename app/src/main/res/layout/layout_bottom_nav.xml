<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮底部导航胶囊：Apple 风格 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/nav_panel_bg"
    app:strokeWidth="0dp">

    <!-- 胶囊底座 -->
    <FrameLayout
        android:id="@+id/navCapsule"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- 滑动指示器 -->
        <View
            android:id="@+id/navIndicator"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_nav_tab_active"
            android:visibility="invisible" />

        <!-- Tab 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 主页 Tab -->
            <FrameLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivNavHome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_dresser"
                        android:contentDescription="主页" />

                    <TextView
                        android:id="@+id/tvNavHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="主页"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 总览 Tab -->
            <FrameLayout
                android:id="@+id/nav_overview"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivNavOverview"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_dress"
                        android:contentDescription="总览" />

                    <TextView
                        android:id="@+id/tvNavOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="总览"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 我的 Tab -->
            <FrameLayout
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivNavProfile"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="我的" />

                    <TextView
                        android:id="@+id/tvNavProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="我的"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
