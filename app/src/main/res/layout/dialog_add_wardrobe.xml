<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilWardrobeName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="柜子名称"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/pink_primary"
        app:startIconDrawable="@android:drawable/ic_menu_edit"
        app:startIconTint="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWardrobeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_base"
        android:text="柜子封面"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_soft"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <ImageView
                android:id="@+id/ivCoverPreview"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:src="@drawable/default_wardrobe_cover" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickCover"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_field_gap"
                android:text="从相册选择"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconSize="16dp"
                app:strokeColor="@color/pink_primary"
                app:strokeWidth="1dp"
                android:textColor="@color/pink_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


</LinearLayout>
