<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_soft"
    tools:context=".MainActivity">

    <!-- Fragment container for main tabs -->
    <FrameLayout
        android:id="@+id/main_content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sub-page overlay (managed by NavigationManager for detail/add/edit pages) -->
    <FrameLayout
        android:id="@+id/sub_page_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_soft"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_soft"
            app:titleTextColor="@color/text_primary"
            app:navigationIconTint="@color/text_primary" />

        <FrameLayout
            android:id="@+id/sub_page_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize">

            <ViewStub
                android:id="@+id/stub_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_wardrobe_detail" />
            <ViewStub
                android:id="@+id/stub_add_dress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_add_dress_new" />
            <ViewStub
                android:id="@+id/stub_dress_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_dress_detail" />
            <ViewStub
                android:id="@+id/stub_profile_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_profile_detail" />
            <ViewStub
                android:id="@+id/stub_stats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_stats" />
            <ViewStub
                android:id="@+id/stub_theme_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_theme_settings" />
            <ViewStub
                android:id="@+id/stub_notifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_notifications" />
            <ViewStub
                android:id="@+id/stub_data_import"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_data_import" />
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom navigation -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>